# Normalize everything to LF in the repository so diffs stay clean no
# matter which OS a contributor works on. Checkout endings are chosen
# per type below.
* text=auto eol=lf

# PowerShell is checked out CRLF on purpose. Windows PowerShell 5.1 --
# which goop targets, not just PowerShell 7 -- has long-standing
# parsing quirks with LF-only here-strings, and prelude.ps1 is executed
# by whatever powershell.exe the user has.
*.ps1 text eol=crlf

# Windows batch files are read by cmd.exe, which requires CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

*.exe binary
